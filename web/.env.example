# Konfigurasi penulisan riwayat oleh backend VestCare.
# Ambil secret/service_role key dari Supabase API settings; jangan gunakan publishable key di sini.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opsional: UUID perangkat virtual. Jika kosong, server memakai UUID tetap yang dibuat otomatis.
# VEST_SUPABASE_DEVICE_ID=

# Opsional: kunci Google Maps JavaScript API untuk peta realtime.
# Batasi kunci dengan HTTP referrer domain dashboard/ngrok Anda.
GOOGLE_MAPS_API_KEY=

# Opsional: titik pusat peta saat GPS belum fix.
VEST_MAP_DEFAULT_LAT=-8.1689
VEST_MAP_DEFAULT_LNG=113.7020
VEST_MAP_ZOOM=17
