# Salin file ini menjadi .env dan isi nilai yang sesuai.
# start_server.py dan start_tunnel.py memuat .env secara otomatis.
# Jangan commit file .env.

# Kunci API acak minimal 32 karakter (wajib sebelum menjalankan Cloudflare Tunnel).
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(32))"
VEST_API_KEY=GANTI_DENGAN_KUNCI_ACAK_MINIMAL_32_KARAKTER

# Path bobot model hasil training (default: models/best.pt)
VEST_MODEL_PATH=models/best.pt

# Folder pustaka klip suara Ardi (cache_ardi) atau hasil siapkan_pustaka.py. Kosongkan/beri path palsu untuk matikan suara server.
VEST_SUARA_FOLDER=suara-natural-ai/cache_ardi

# Ukuran gambar inferensi - SAMAKAN dengan training (416)
VEST_IMGSZ=416

# Ambang confidence deteksi (default 0.35)
VEST_CONF=0.35

# File riwayat deteksi (JSONL)
VEST_RIWAYAT_PATH=data/riwayat.jsonl

# Suara peringatan diputar oleh browser di ponsel (1 = tidak memutar di server).
VEST_TANPA_SUARA=1

# Token Cloudflare Tunnel (untuk run_tunnel.bat)
# CLOUDFLARED_TOKEN=token-dari-cloudflare-zero-trust
