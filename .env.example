# Salin file ini menjadi .env dan isi nilai yang sesuai, lalu muat sebelum menjalankan server.
# Windows PowerShell:   Get-Content .env | ForEach-Object { if ($_ -match "=") { $a=$_.Split("=",2); $env:$a[0]=$a[1] } }
# Atau atur per variabel di terminal sebelum run_server.bat.

# Kunci API untuk mengamankan endpoint (wajib diisi saat deploy ke awan)
VEST_API_KEY=kunci-rahasia-anda-di-sini

# Path bobot model hasil training (default: models/best.pt)
VEST_MODEL_PATH=models/best.pt

# Folder pustaka klip suara (hasil siapkan_pustaka.py). Kosongkan/beri path palsu untuk matikan suara.
VEST_SUARA_FOLDER=cache_suara

# Ukuran gambar inferensi - SAMAKAN dengan training (416)
VEST_IMGSZ=416

# Ambang confidence deteksi (default 0.35)
VEST_CONF=0.35

# File riwayat deteksi (JSONL)
VEST_RIWAYAT_PATH=data/riwayat.jsonl

# Matikan output suara (1 = mati, berguna untuk server tanpa speaker)
VEST_TANPA_SUARA=0

# Token Cloudflare Tunnel (untuk run_tunnel.bat)
# CLOUDFLARED_TOKEN=token-dari-cloudflare-zero-trust
